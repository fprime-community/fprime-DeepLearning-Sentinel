# Datasets are never committed to this repository - see Objective.md, section 9.5.
# Telemetry lives in the project R2 bucket; data/ is a local staging path only.
data/
*.parquet
*.hdf5
*.h5
*.npy
*.npz
*.csv.gz

# Trained artifacts and experiment output
models/
runs/
outputs/
*.ckpt
*.pt
*.pth

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Ingest working area -- nothing here is ever committed
scratch/
*.zip
*.pkl

# Flight golden vectors: the small tiers are committed so the C++ suite is
# self-contained and cannot drift. G3's weight file is 285 KB and regenerates
# from its seed, and the G4 tier is built from cached production weights under
# runs/, which is gitignored -- neither is committed.
flight/test/vectors/g3.bin
flight/test/vectors/g4_*
flight/test/vectors/manifest_local.json
flight/build/

# The F' toolchain, work item 9. The framework checkout, its tool venv and every
# build cache are reproduced by scripts/fprime_setup.sh, never committed. Only the
# project's own sources under fprime/ -- the component, the deployment, settings.ini
# and CMakeLists.txt -- are tracked.
fprime/lib/
fprime/fprime-venv/
fprime/build-fprime-automatic-*/
fprime/build-artifacts/
