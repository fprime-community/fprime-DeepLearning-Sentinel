# Cloudflare R2 credentials for the fprime-sentinel data bucket.
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Find these in the Cloudflare dashboard under R2 > Manage R2 API Tokens.
# The token needs Object Read & Write on the bucket below.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fprime-sentinel-data
